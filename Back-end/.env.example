# FitCore backend environment — copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Port the API listens on
PortProject=4000

# MongoDB connection string
DatabaseConectionString=

# "production" enables secure cookies, HSTS and __Host- CSRF cookie
ProjectEnv=development

# Secret used to sign JWTs (use a long random string, rotate periodically)
JWT_SECRET=

# Access-token lifetime (e.g. 15m, 1h, 7d). Defaults to 7d if unset.
JWT_EXPIRES_IN=7d

# Secret for CSRF double-submit tokens. Defaults to JWT_SECRET if unset;
# set a dedicated value in production.
CSRF_SECRET=

# Public URL of the web frontend (used for CORS and activation links)
FRONTEND_URL=http://localhost:5173

# Gmail account + app password used to send activation emails
GMAIL_USER=
GMAIL_APP_PASSWORD=
